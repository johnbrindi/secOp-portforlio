generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model profiles {
  id         String   @id @db.Uuid
  name       String?
  title      String?
  bio        String?
  image_url  String?
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model skills {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  category   String?  @default("General")
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model projects {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  image_url   String?
  tags        String[]
  link        String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model certifications {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  issuer      String?
  date_issued String?
  description String?
  link        String?
  image_url   String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model posts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  excerpt    String?
  content    String?
  category   String?
  tags       String[]
  image_url  String?
  featured   Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model contacts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  subject    String?
  message    String
  read       Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

// Opportunities already emailed by the daily digest (app/api/cron/opportunities).
model opportunities {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String    @unique
  stream       String    @default("tech")
  url          String
  title        String
  source       String
  section      String
  category     String
  score        Int
  summary      String?
  company      String?
  location     String?
  topics       String[]  @default([])
  destination  String?
  deadline     String?
  // Parsed deadline; listings are deleted two days after it (lib/opportunities/run.ts).
  deadline_at  DateTime? @db.Timestamptz(6)
  fully_funded Boolean?
  published_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
}

// One row per digest run, shown on /admin/opportunities.
model opportunity_runs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ran_at          DateTime @default(now()) @db.Timestamptz(6)
  trigger         String
  tech_new        Int
  scholarship_new Int
  emails_sent     Int
  sources         Json
  error           String?
  duration_ms     Int
}

// Admin devices that receive web push notifications (lib/push.ts).
model push_subscriptions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

// Portfolio visits (one per browser session), used for visitor notifications.
// The IP is stored only as a salted hash.
model visits {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ip_hash    String
  path       String
  referrer   String?
  country    String?
  city       String?
  device     String?
  notified   Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([ip_hash, created_at])
}

// Admin accounts (lib/admin-users.ts). Passwords are stored only as scrypt hashes.
// Failed sign-ins lock the account for 15 minutes after 5 attempts.
model admin_users {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  password_hash   String
  failed_attempts Int       @default(0)
  locked_until    DateTime? @db.Timestamptz(6)
  last_login_at   DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
}
