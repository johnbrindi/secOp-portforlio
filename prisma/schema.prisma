generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model profiles {
  id         String   @id @db.Uuid
  name       String?
  title      String?
  bio        String?
  image_url  String?
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model skills {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  category   String?  @default("General")
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model projects {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  image_url   String?
  tags        String[]
  link        String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model certifications {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  issuer      String?
  date_issued String?
  description String?
  link        String?
  image_url   String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model posts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  excerpt    String?
  content    String?
  category   String?
  tags       String[]
  image_url  String?
  featured   Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model contacts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  subject    String?
  message    String
  read       Boolean? @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

// Opportunities already emailed by the daily digest (app/api/cron/opportunities).
model opportunities {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String    @unique
  stream       String    @default("tech")
  url          String
  title        String
  source       String
  section      String
  category     String
  score        Int
  published_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
}

// One row per digest run, shown on /admin/opportunities.
model opportunity_runs {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ran_at          DateTime @default(now()) @db.Timestamptz(6)
  trigger         String
  tech_new        Int
  scholarship_new Int
  emails_sent     Int
  sources         Json
  error           String?
  duration_ms     Int
}
