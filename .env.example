# ── Database (Neon Postgres via Prisma) ──────────────────────────
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── Admin authentication (Okta OIDC via NextAuth) ────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_ISSUER="https://your-org.okta.com"
# Comma-separated. Only these identities can reach /admin, even if Okta lets others sign in.
ADMIN_EMAILS="johnbrindimazwewoh@gmail.com"

# ── Contact form notifications (optional, https://resend.com) ────
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL="johnbrindimazwewoh@gmail.com"
# Must be on a domain verified in Resend; the default sandbox sender only delivers to your own Resend account email
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ── Sanity CMS (optional — the site falls back to built-in content) ─
SANITY_PROJECT_ID=""
SANITY_DATASET="production"
SANITY_API_VERSION="2025-02-01"
